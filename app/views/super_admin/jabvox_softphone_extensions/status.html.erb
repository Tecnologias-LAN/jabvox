<% content_for(:title) { 'Estado del Softphone' } %>
<% auto = params[:auto] == '1' %>
<% if auto %><meta http-equiv="refresh" content="15"><% end %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <header class="main-content__header m-0 p-0 border-0">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Estado del Softphone</h1>
    </header>
    <div class="flex items-center gap-3">
      <% if auto %>
        <span class="flex items-center text-sm text-gray-600 bg-gray-100 px-3 py-1.5 rounded-md font-medium">
          <span class="w-2.5 h-2.5 bg-green-500 rounded-full mr-2 animate-pulse"></span>
          En vivo (15s)
        </span>
        <%= link_to 'Pausar', status_super_admin_jabvox_softphone_extensions_path(request.query_parameters.except(:auto)), class: 'inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
      <% else %>
        <%= link_to '● En vivo', status_super_admin_jabvox_softphone_extensions_path(request.query_parameters.merge(auto: 1)), class: 'inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500' %>
      <% end %>
      <%= link_to 'Configuración', super_admin_jabvox_softphone_extensions_path, class: 'inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
    </div>
  </div>

  <%#=== Estado en vivo por cuenta / extensión ===%>
  <% if @accounts_status.empty? %>
    <div class="bg-white border border-gray-200 rounded-xl mb-6 shadow-sm overflow-hidden">
      <p class="p-6 text-sm text-gray-500 text-center">Ninguna cuenta tiene el softphone habilitado.</p>
    </div>
  <% end %>

  <% @accounts_status.each do |account, st| %>
    <div class="bg-white border border-gray-200 rounded-xl mb-6 shadow-sm overflow-hidden">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 bg-gray-50 border-b border-gray-200">
        <div>
          <div class="text-base font-bold text-gray-900">#<%= account.id %> · <%= account.name %></div>
          <% if st[:server].present? %>
            <div class="text-xs text-gray-500 font-mono mt-0.5"><%= st[:server] %></div>
          <% end %>
        </div>
        <%
          badge_classes = case st[:account_status]
                          when Jabvox::Softphone::StatusService::OK then 'bg-green-100 text-green-800'
                          when Jabvox::Softphone::StatusService::DISABLED then 'bg-slate-100 text-slate-600'
                          when Jabvox::Softphone::StatusService::NO_CONFIG, Jabvox::Softphone::StatusService::NOT_CONFIGURED then 'bg-yellow-100 text-yellow-800'
                          else 'bg-slate-100 text-slate-600'
                          end
          badge_label = case st[:account_status]
                        when Jabvox::Softphone::StatusService::OK then 'Operativo'
                        when Jabvox::Softphone::StatusService::DISABLED then 'Deshabilitado'
                        when Jabvox::Softphone::StatusService::NO_CONFIG then 'Sin configuración'
                        when Jabvox::Softphone::StatusService::NOT_CONFIGURED then 'Servidor incompleto'
                        else st[:account_status]
                        end
        %>
        <span class="text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap <%= badge_classes %>"><%= badge_label %></span>
      </div>

      <% if st[:reason].present? %>
        <div class="text-xs text-red-700 bg-red-50 p-3 flex flex-wrap items-center gap-2 border-b border-red-100">
          <span><span class="font-bold mr-1">⚠</span> <%= st[:reason] %></span>
          <% if st[:error_code].present? %>
            <span class="font-mono text-[11px] bg-red-100 text-red-800 px-1.5 py-0.5 rounded border border-red-200"><%= st[:error_code] %></span>
          <% end %>
        </div>
      <% end %>

      <% if st[:extensions].any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-white border-b border-gray-100">
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Extensión</th>
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Usuario</th>
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Credencial SIP</th>
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado en tiempo real</th>
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Último visto</th>
                <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">IP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% st[:extensions].each do |ext| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-3 px-4 text-sm text-gray-900 font-bold whitespace-nowrap"><%= ext[:extension] %></td>
                  <td class="py-3 px-4 text-sm text-gray-700 whitespace-nowrap"><%= ext[:user] || '—' %></td>
                  <td class="py-3 px-4 text-sm whitespace-nowrap">
                    <% if ext[:has_credential] && ext[:webrtc_enabled] %>
                      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-green-100 text-green-800">Lista</span>
                    <% elsif ext[:has_credential] %>
                      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">Deshabilitada</span>
                    <% else %>
                      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-red-100 text-red-800">Falta secreto</span>
                    <% end %>
                  </td>
                  <td class="py-3 px-4 text-sm text-gray-700 whitespace-nowrap">
                    <%
                      dot_color, label = case ext[:state]
                                         when 'online'          then ['bg-green-500',  'Conectada']
                                         when 'on_call'         then ['bg-blue-500',   'En llamada']
                                         when 'connecting'      then ['bg-yellow-500', 'Conectando']
                                         when 'offline'         then ['bg-slate-300',  'Desconectada']
                                         when 'error'           then ['bg-red-500',    'Con error']
                                         when 'never_connected' then ['bg-slate-300',  'Nunca conectó']
                                         when 'no_credential'   then ['bg-slate-300',  'Sin credencial']
                                         else ['bg-yellow-500', 'Desconocido']
                                         end
                    %>
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full <%= dot_color %>"></span>
                      <span><%= label %></span>
                    </div>
                    <% if ext[:last_error].present? %>
                      <div class="mt-1"><span class="font-mono text-[11px] bg-red-100 text-red-800 px-1.5 py-0.5 rounded"><%= ext[:last_error] %></span></div>
                    <% end %>
                  </td>
                  <td class="py-3 px-4 text-xs text-gray-500 whitespace-nowrap"><%= ext[:last_seen_at] ? "#{time_ago_in_words(ext[:last_seen_at])} atrás" : '—' %></td>
                  <td class="py-3 px-4 text-xs text-gray-500 font-mono whitespace-nowrap"><%= ext[:remote_ip] || '—' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-4 text-sm text-gray-500">Sin extensiones ligadas en esta cuenta.</p>
      <% end %>
    </div>
  <% end %>

  <%#=== Historial de llamadas con filtros ===%>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mt-8">
    <div class="text-base font-bold text-gray-900 p-4 pb-0">Historial de llamadas</div>

    <%= form_tag status_super_admin_jabvox_softphone_extensions_path, method: :get, class: 'flex flex-wrap items-end gap-3 p-4 bg-gray-50 border-b border-gray-200 mt-4' do %>
      <%= hidden_field_tag :auto, params[:auto] if params[:auto].present? %>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Cuenta</label>
        <%= select_tag :account_id,
              options_from_collection_for_select(@filter_accounts, :id, ->(a) { "##{a.id} #{a.name}" }, params[:account_id]),
              include_blank: 'Todas', class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 min-w-[120px] focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Extensión</label>
        <%= text_field_tag :extension, params[:extension], placeholder: 'ej. 1012', size: 8, class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Estado</label>
        <%= select_tag :status,
              options_for_select([['Todos', ''], ['Sonando', 'ringing'], ['Contestada', 'answered'], ['No contestada', 'missed'], ['Fallida', 'failed'], ['Terminada', 'ended']], params[:status]),
              class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Dirección</label>
        <%= select_tag :direction,
              options_for_select([['Todas', ''], ['Saliente', 'outbound'], ['Entrante', 'inbound']], params[:direction]),
              class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Desde</label>
        <%= date_field_tag :from, params[:from], class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex flex-col">
        <label class="text-xs font-semibold text-gray-500 mb-1">Hasta</label>
        <%= date_field_tag :to, params[:to], class: 'text-sm border border-gray-300 rounded-md px-2 py-1.5 focus:ring-blue-500 focus:border-blue-500' %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag 'Filtrar', class: 'inline-flex justify-center py-1.5 px-3 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 cursor-pointer' %>
        <%= link_to 'Limpiar', status_super_admin_jabvox_softphone_extensions_path, class: 'inline-flex justify-center py-1.5 px-3 border border-transparent shadow-sm text-sm font-medium rounded-md text-gray-500 hover:text-gray-700' %>
      </div>
    <% end %>

    <% if @call_logs.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-white border-b border-gray-100">
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Fecha</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Cuenta</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Ext</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Usuario</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Número</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Dir</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Quién colgó</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Codec</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Duración</th>
              <th class="py-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Fallo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @call_logs.each do |log| %>
              <tr class="hover:bg-gray-50">
                <td class="py-2 px-3 text-[11px] text-gray-500 whitespace-nowrap"><%= log.started_at&.strftime('%d/%m %H:%M:%S') %></td>
                <td class="py-2 px-3 text-xs text-gray-500 whitespace-nowrap">#<%= log.account_id %></td>
                <td class="py-2 px-3 text-sm font-bold text-gray-900 whitespace-nowrap"><%= log.extension %></td>
                <td class="py-2 px-3 text-sm text-gray-700 whitespace-nowrap"><%= log.user&.name || log.user&.email || '—' %></td>
                <td class="py-2 px-3 text-sm text-gray-900 whitespace-nowrap"><%= log.contact_name.present? ? "#{log.contact_name} (#{log.phone_number})" : log.phone_number %></td>
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full <%= log.direction == 'inbound' ? 'bg-blue-100 text-blue-800' : 'bg-slate-100 text-slate-600' %>">
                    <%= log.direction == 'inbound' ? '↓ Entra' : '↑ Sale' %>
                  </span>
                </td>
                <td class="py-2 px-3 whitespace-nowrap">
                  <%
                    scls = case log.status
                           when 'answered', 'ended' then 'bg-green-100 text-green-800'
                           when 'missed' then 'bg-yellow-100 text-yellow-800'
                           when 'failed' then 'bg-red-100 text-red-800'
                           else 'bg-slate-100 text-slate-600'
                           end
                    slbl = { 'ringing' => 'Sonando', 'answered' => 'Contestada', 'missed' => 'No contestada', 'failed' => 'Fallida', 'ended' => 'Terminada' }[log.status] || log.status
                  %>
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full <%= scls %>"><%= slbl %></span>
                </td>
                <td class="py-2 px-3 text-xs text-gray-500 whitespace-nowrap"><%= { 'agent' => 'Agente', 'remote' => 'Remoto' }[log.ended_by] || '—' %></td>
                <td class="py-2 px-3 text-xs text-gray-500 whitespace-nowrap"><%= log.codec || '—' %></td>
                <td class="py-2 px-3 text-xs text-gray-500 whitespace-nowrap"><%= log.duration_seconds ? "#{log.duration_seconds}s" : '—' %></td>
                <td class="py-2 px-3 text-xs text-gray-500 whitespace-nowrap"><% if log.failure_reason.present? %><span class="font-mono text-[10px] bg-red-100 text-red-800 px-1 py-0.5 rounded"><%= log.failure_reason %></span><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="flex justify-between items-center p-4 bg-gray-50 text-xs text-gray-500 border-t border-gray-200">
        <span><%= @total_logs %> llamada(s) · página <%= @page %> de <%= (@total_logs / @per_page.to_f).ceil %></span>
        <span class="flex gap-2">
          <% if @page > 1 %><%= link_to '‹ Anterior', status_super_admin_jabvox_softphone_extensions_path(request.query_parameters.merge(page: @page - 1)), class: 'px-2 py-1 border border-gray-300 rounded bg-white hover:bg-gray-100' %><% end %>
          <% if @page * @per_page < @total_logs %><%= link_to 'Siguiente ›', status_super_admin_jabvox_softphone_extensions_path(request.query_parameters.merge(page: @page + 1)), class: 'px-2 py-1 border border-gray-300 rounded bg-white hover:bg-gray-100' %><% end %>
        </span>
      </div>
    <% else %>
      <p class="p-6 text-sm text-gray-500 text-center">No hay llamadas con los filtros seleccionados.</p>
    <% end %>
  </div>
</div>
