<%# Show de una transacción de pago→aprovisionamiento, con reintento manual. %>
<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>

  <div>
    <%# Aprobar manualmente: SOLO para transacciones de PRUEBA (sandbox) que aún no están
        pagadas. En producción NO se permite (el pago real lo confirma la pasarela). %>
    <% if page.resource.sandbox? && !page.resource.paid? %>
      <%= link_to(
        "Aprobar pago (PRUEBA) y aprovisionar",
        mark_paid_manually_super_admin_jabvox_provisioning_transaction_path(page.resource),
        class: "button",
        method: :post,
        data: { confirm: "Esta es una transacción de PRUEBA (sandbox). ¿Aprobarla manualmente y activar la cuenta?" }
      ) %>
    <% end %>

    <% if page.resource.retriable? %>
      <%= link_to(
        "Reintentar aprovisionamiento",
        retry_provisioning_super_admin_jabvox_provisioning_transaction_path(page.resource),
        class: "button",
        method: :post,
        data: { confirm: "¿Reintentar el aprovisionamiento de esta transacción?" }
      ) %>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <dl>
    <% page.attributes.each do |title, attributes| %>
      <fieldset class="<%= "field-unit--nested" if title.present? %>">
        <% if title.present? %>
          <legend><%= t "helpers.label.#{page.resource_name}.#{title}", default: title %></legend>
        <% end %>

        <% attributes.each do |attribute| %>
          <dt class="attribute-label" id="<%= attribute.name %>">
          <%= t(
            "helpers.label.#{resource_name}.#{attribute.name}",
            default: page.resource.class.human_attribute_name(attribute.name),
          ) %>
          </dt>

          <dd class="attribute-data attribute-data--<%=attribute.html_class%>"
              ><%= render_field attribute, page: page %></dd>
        <% end %>
      </fieldset>
    <% end %>
  </dl>
</section>
