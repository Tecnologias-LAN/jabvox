<% content_for(:title) { "Automatizaciones Avanzadas – #{@account.name}" } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    Automatizaciones Avanzadas — <%= @account.name %>
  </h1>
  <%= link_to 'Volver a la cuenta', super_admin_account_path(@account), class: 'button' %>
</header>

<section class="main-content__body">
  <% if notice %>
    <p class="flash flash--notice"><%= notice %></p>
  <% end %>
  <% if alert %>
    <p class="flash flash--error"><%= alert %></p>
  <% end %>

  <%# Estado del módulo. Se pinta siempre, no como flash: un flash desaparece al
      recargar y este estado no debe. %>
  <div style="margin-bottom:24px; padding:16px; border-radius:8px;
              background:<%= @config.enabled? ? '#dcfce7' : '#f3f4f6' %>;
              border:1px solid <%= @config.enabled? ? '#86efac' : '#d1d5db' %>;">
    <p style="margin:0 0 4px; font-size:13px; color:#374151;">
      Estado del módulo:
      <span style="display:inline-block; padding:2px 10px; border-radius:12px; font-size:12px; font-weight:600;
                   background:#ffffffcc; color:<%= @config.enabled? ? '#166534' : '#4b5563' %>;">
        <%= @config.enabled? ? 'Activo' : 'Inactivo' %>
      </span>
    </p>
    <p style="margin:0; font-size:12px; color:#4b5563;">
      El motor de flujos corre dentro de Jabvox: no hay servicio externo que configurar.
      Con el módulo inactivo, toda la API de flujos responde 403.
    </p>
  </div>

  <div style="margin-bottom:24px; padding:16px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px;">
    <h3 style="font-weight:600; font-size:14px; margin:0 0 8px;">Uso actual</h3>
    <p style="margin:0; font-size:13px; color:#374151;">
      Flujos creados: <strong><%= @flows_count %></strong>
      &nbsp;·&nbsp;
      Tope de esta cuenta:
      <strong><%= @config.max_flows.presence || 'sin tope propio' %></strong>
      &nbsp;·&nbsp;
      Incluido en el plan: <strong><%= @plan_limit.positive? ? @plan_limit : 'no definido' %></strong>
    </p>
    <p style="margin:8px 0 0; font-size:12px; color:#6b7280;">
      El tope efectivo es el MENOR de los dos valores definidos. Si ninguno lo está, la cuenta es ilimitada.
      El límite se aplica en el servidor al crear un flujo, no solo en la interfaz.
    </p>
  </div>

  <div style="margin-bottom:24px; padding:16px; background:#ffffff; border:1px solid #e5e7eb; border-radius:8px;">
    <h3 style="font-weight:600; font-size:14px; margin:0 0 12px;">Límite de flujos de la cuenta</h3>
    <%= form_with url: update_limit_super_admin_account_account_automations_path(@account), method: :patch, local: true do |f| %>
      <div style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
        <div>
          <%= f.label :max_flows, 'Máximo de flujos', style: 'display:block; font-size:12px; color:#374151; margin-bottom:4px;' %>
          <%= f.number_field :max_flows, value: @config.max_flows, min: 1, placeholder: 'vacío = sin tope propio',
                             style: 'padding:6px 10px; border:1px solid #d1d5db; border-radius:6px; width:220px;' %>
        </div>
        <%= f.submit 'Guardar límite', class: 'button' %>
      </div>
      <p style="margin:8px 0 0; font-size:12px; color:#6b7280;">
        Déjalo vacío para no imponer un tope propio; en ese caso manda lo que diga el plan.
      </p>
    <% end %>
  </div>

  <div style="padding:16px; background:#ffffff; border:1px solid #e5e7eb; border-radius:8px;">
    <h3 style="font-weight:600; font-size:14px; margin:0 0 12px;">Activación del módulo</h3>
    <%= form_with url: toggle_super_admin_account_account_automations_path(@account), method: :patch, local: true do |f| %>
      <%= f.hidden_field :max_flows, value: @config.max_flows %>
      <%= f.submit @config.enabled? ? 'Desactivar módulo' : 'Activar módulo', class: 'button' %>
    <% end %>
    <p style="margin:8px 0 0; font-size:12px; color:#6b7280;">
      Activar enciende también el acceso al módulo en el panel de la cuenta.
      Desactivar no borra ningún flujo: solo cierra la API y el menú.
    </p>
  </div>
</section>
