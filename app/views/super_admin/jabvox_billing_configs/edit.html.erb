<% content_for(:title) { "Configuración de Facturación" } %>

<%= render(
  "shared/super_admin/back_link",
  link: :back,
  name: "Volver"
) %>

<section class="content-wrapper">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Configuración de Facturación y Limpieza de Cuentas</h3>
    </div>

    <div class="card-body">
      <%= form_with(
        model: @config,
        url: super_admin_jabvox_billing_config_path,
        method: :patch,
        local: true,
        class: "form-horizontal"
      ) do |form| %>

        <div class="form-group">
          <%= form.label :unpaid_account_cleanup_days, "Días de gracia para cuentas sin pago", class: "control-label" %>
          <%= form.number_field :unpaid_account_cleanup_days,
              class: "form-control",
              min: 1,
              required: true,
              placeholder: "7" %>
          <p class="help-block">
            <i class="fas fa-info-circle"></i>
            Número de días que una cuenta puede permanecer en estado <code>payment_pending</code> antes de ser eliminada automáticamente.
            <br>
            <strong>Recomendado:</strong> 7 días (1 semana de gracia).
          </p>
        </div>

        <div class="alert alert-warning">
          <i class="fas fa-exclamation-triangle"></i>
          <strong>Importante:</strong>
          <ul class="mb-0">
            <li>Las cuentas eliminadas <strong>no se pueden recuperar</strong>.</li>
            <li>El job de limpieza se ejecuta <strong>diariamente a las 3:07 AM UTC</strong>.</li>
            <li>Solo se eliminan cuentas que:
              <ul>
                <li>Estén en estado <code>payment_pending</code></li>
                <li>No tengan transacciones de pago aprobadas</li>
                <li>Fueron creadas hace más tiempo del configurado</li>
              </ul>
            </li>
          </ul>
        </div>

        <div class="form-group">
          <%= form.submit "Guardar Configuración", class: "btn btn-primary" %>
          <%= link_to "Cancelar", :back, class: "btn btn-default" %>
        </div>

      <% end %>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h3 class="card-title">Estado del Sistema</h3>
    </div>
    <div class="card-body">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th width="40%">Job de limpieza</th>
            <td><code>Jabvox::Billing::PendingAccountCleanupJob</code></td>
          </tr>
          <tr>
            <th>Cola de procesamiento</th>
            <td><code>jabvox_payments</code></td>
          </tr>
          <tr>
            <th>Frecuencia</th>
            <td>Diaria (3:07 AM UTC)</td>
          </tr>
          <tr>
            <th>Worker responsable</th>
            <td><code>chatwoot-worker-payments.service</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
