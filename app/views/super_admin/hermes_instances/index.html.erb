<% content_for(:title) { 'Hermes — Aprovisionador' } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Hermes — Aprovisionador</h1>
</header>

<section class="main-content__body">
  <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
  <% if alert %><p class="flash flash--error"><%= alert %></p><% end %>

  <div style="margin-bottom:24px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
    <p style="font-size:13px; color:#374151; margin:0;">
      El <strong>Hermes Aprovisionador</strong> es global: se configura una sola vez como un
      agente (nombre, URL y token). Aquí lo conectas y eliges en qué cuentas se activa; cada
      cuenta activada verá su <strong>Chat Aprovisionador</strong>, que habla con este mismo
      agente. El Chat IA de cada cuenta es aparte (se gestiona en <em>Ajustes → Chat IA</em>).
    </p>
  </div>

  <!-- Estado + conexión del agente Aprovisionador global -->
  <h2 style="font-size:15px; font-weight:600; margin:0 0 12px;">Hermes Aprovisionador (global)</h2>
  <div style="margin-bottom:8px; font-size:13px; color:#374151;">
    Estado:
    <strong style="color:<%= @provisioner[:connected] ? '#16a34a' : '#b91c1c' %>;">
      <%= @provisioner[:status] %>
    </strong>
    <% if @provisioner[:base_url].present? %>· <code><%= @provisioner[:base_url] %></code><% end %>
    <% if @provisioner[:linked_accounts].to_i.positive? %>· <%= @provisioner[:linked_accounts] %> cuenta(s) activada(s)<% end %>
    <% if @provisioner[:last_error].present? %>
      <span style="color:#b91c1c;">· <%= @provisioner[:last_error] %></span>
    <% end %>
  </div>

  <%= form_with url: connect_provisioner_super_admin_hermes_instances_path, method: :post, local: true do |form| %>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :name, 'Nombre visible' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :name, value: @provisioner[:name], placeholder: 'Agente Aprovisionador' %>
        <p class="pt-2 text-xs italic text-slate-400">Nombre del agente (solo referencia interna).</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :hermes_agent_name, 'Nombre del agente en Hermes' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :hermes_agent_name, value: @provisioner[:hermes_agent_name], placeholder: 'mi-agente' %>
        <p class="pt-2 text-xs italic text-slate-400">El identificador del agente dentro de Hermes.</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :base_url, 'URL del agente' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :base_url, value: @provisioner[:base_url], placeholder: 'http://tu-hermes.ejemplo:PUERTO/p/mi-agente/v1' %>
        <p class="pt-2 text-xs italic text-slate-400">Host:puerto del gateway de Hermes, con el prefijo <code>/p/&lt;agente&gt;/v1</code>.</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :service_token, 'Token del agente' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.password_field :service_token, placeholder: '(en blanco = conservar)' %>
        <p class="pt-2 text-xs italic text-slate-400">Bearer token del agente. Se guarda cifrado. Nunca se muestra.</p>
      </div>
    </div>
    <%= form.submit 'Conectar aprovisionador', class: 'button' %>
  <% end %>

  <!-- Cuentas: activar/desactivar el Chat Aprovisionador -->
  <h2 style="font-size:15px; font-weight:600; margin:28px 0 12px;">Cuentas</h2>
  <p style="font-size:12px; color:#6b7280; margin:0 0 8px;">Activa el Chat Aprovisionador en las cuentas que lo necesiten. Todas usan el mismo agente global de arriba.</p>
  <table class="w-full" style="font-size:13px;">
    <thead>
      <tr style="text-align:left; border-bottom:1px solid #e5e7eb;">
        <th style="padding:8px;">Cuenta</th>
        <th style="padding:8px;">Chat Aprovisionador</th>
        <th style="padding:8px;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @instances.each do |inst| %>
        <tr style="border-bottom:1px solid #f3f4f6;">
          <td style="padding:8px;">#<%= inst[:account_id] %> — <%= inst[:account_name] %></td>
          <td style="padding:8px;">
            <strong style="color:<%= inst[:linked] ? '#16a34a' : '#9ca3af' %>;">
              <%= inst[:linked] ? 'Activado' : 'Desactivado' %>
            </strong>
          </td>
          <td style="padding:8px; white-space:nowrap;">
            <% if inst[:linked] %>
              <%= button_to 'Desactivar', unlink_account_super_admin_hermes_instance_path(inst[:account_id]), method: :post, class: 'button', form_class: 'inline-block' %>
            <% else %>
              <%= button_to 'Activar', link_account_super_admin_hermes_instance_path(inst[:account_id]), method: :post, class: 'button button--secondary', form_class: 'inline-block' %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @instances.empty? %>
        <tr><td colspan="3" style="padding:16px; color:#9ca3af;">No hay cuentas con Chat IA todavía.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>
