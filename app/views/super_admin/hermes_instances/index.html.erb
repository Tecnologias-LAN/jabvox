<% content_for(:title) { 'Hermes — Aprovisionador' } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Hermes — Aprovisionador</h1>
</header>

<section class="main-content__body">
  <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
  <% if alert %><p class="flash flash--error"><%= alert %></p><% end %>

  <div style="margin-bottom:24px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
    <p style="font-size:13px; color:#374151; margin:0;">
      El <strong>Hermes Aprovisionador</strong> es global: se configura una sola vez como un
      agente (nombre, URL y token). Aquí lo conectas y eliges en qué cuentas se activa; cada
      cuenta activada verá su <strong>Chat Aprovisionador</strong>, que habla con este mismo
      agente. El Chat IA de cada cuenta es aparte (se gestiona en <em>Ajustes → Chat IA</em>).
    </p>
  </div>

  <!-- Estado + conexión del agente Aprovisionador global -->
  <h2 style="font-size:15px; font-weight:600; margin:0 0 12px;">Hermes Aprovisionador (global)</h2>
  <div style="margin-bottom:8px; font-size:13px; color:#374151;">
    Estado:
    <strong style="color:<%= @provisioner[:connected] ? '#16a34a' : '#b91c1c' %>;">
      <%= @provisioner[:status] %>
    </strong>
    <% if @provisioner[:base_url].present? %>· <code><%= @provisioner[:base_url] %></code><% end %>
    <% if @provisioner[:linked_accounts].to_i.positive? %>· <%= @provisioner[:linked_accounts] %> cuenta(s) activada(s)<% end %>
    <% if @provisioner[:last_error].present? %>
      <span style="color:#b91c1c;">· <%= @provisioner[:last_error] %></span>
    <% end %>
  </div>

  <%= form_with url: connect_provisioner_super_admin_hermes_instances_path, method: :post, local: true do |form| %>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :name, 'Nombre visible' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :name, value: @provisioner[:name], placeholder: 'Agente Aprovisionador' %>
        <p class="pt-2 text-xs italic text-slate-400">Nombre del agente (solo referencia interna).</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :hermes_agent_name, 'Nombre del agente en Hermes' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :hermes_agent_name, value: @provisioner[:hermes_agent_name], placeholder: 'mi-agente' %>
        <p class="pt-2 text-xs italic text-slate-400">El identificador del agente dentro de Hermes.</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :base_url, 'URL del agente' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field :base_url, value: @provisioner[:base_url], placeholder: 'http://tu-hermes.ejemplo:PUERTO/p/mi-agente/v1' %>
        <p class="pt-2 text-xs italic text-slate-400">Host:puerto del gateway de Hermes, con el prefijo <code>/p/&lt;agente&gt;/v1</code>.</p>
      </div>
    </div>
    <div class="flex mb-4">
      <div class="field-unit__label"><%= form.label :service_token, 'Token del agente' %></div>
      <div class="-mt-2 field-unit__field">
        <%= form.password_field :service_token, placeholder: '(en blanco = conservar)' %>
        <p class="pt-2 text-xs italic text-slate-400">Bearer token del agente. Se guarda cifrado. Nunca se muestra.</p>
      </div>
    </div>
    <%= form.submit 'Conectar aprovisionador', class: 'button' %>
  <% end %>

  <!-- Cuentas: activar/desactivar el Chat Aprovisionador -->
  <h2 style="font-size:15px; font-weight:600; margin:28px 0 12px;">Cuentas</h2>
  <p style="font-size:12px; color:#6b7280; margin:0 0 8px;">Activa el Chat Aprovisionador en las cuentas que lo necesiten. Todas usan el mismo agente global de arriba.</p>
  <table class="w-full" style="font-size:13px;">
    <thead>
      <tr style="text-align:left; border-bottom:1px solid #e5e7eb;">
        <th style="padding:8px;">Cuenta</th>
        <th style="padding:8px;">Chat Aprovisionador</th>
        <th style="padding:8px;">IPs autorizadas del Hermes</th>
        <th style="padding:8px;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @instances.each do |inst| %>
        <tr style="border-bottom:1px solid #f3f4f6;">
          <td style="padding:8px;">#<%= inst[:account_id] %> — <%= inst[:account_name] %></td>
          <td style="padding:8px;">
            <strong style="color:<%= inst[:linked] ? '#16a34a' : '#9ca3af' %>;">
              <%= inst[:linked] ? 'Activado' : 'Desactivado' %>
            </strong>
          </td>
          <td style="padding:8px;">
            <% if inst[:connections].blank? %>
              <span style="color:#9ca3af;">Sin conexiones Hermes</span>
            <% else %>
              <% inst[:connections].each do |conn| %>
                <%# Solo desde estas IPs puede ese Hermes ejecutar acciones sobre la cuenta.
                    Vacío = no ejecuta nada (fail-closed). Acepta IP suelta o CIDR, incluidas
                    las privadas de ZeroTier. %>
                <%= form_with url: update_allowed_ips_super_admin_hermes_instance_path(inst[:account_id]), method: :post, local: true, html: { style: 'margin:0 0 6px;' } do |f| %>
                  <%= f.hidden_field :connection_id, value: conn[:id] %>
                  <div style="display:flex; align-items:center; gap:6px;">
                    <span style="min-width:120px; color:#6b7280;"><%= conn[:name] %></span>
                    <%= f.text_field :allowed_ips, value: conn[:allowed_ips].join(', '),
                                     placeholder: '203.0.113.5, 10.147.17.0/24',
                                     style: 'font-family:monospace; font-size:12px; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px; width:260px;' %>
                    <%= f.submit 'Guardar', class: 'button button--secondary', style: 'font-size:12px; padding:4px 10px;' %>
                    <% if conn[:allowed_ips].blank? %>
                      <span style="color:#d97706; font-size:12px;" title="Sin IPs no puede ejecutar nada">⚠ bloqueado</span>
                    <% end %>
                  </div>
                <% end %>
                <%# Token de acción (Hermes → Jabvox): se muestra para configurarlo en el
                    gateway de Hermes y se puede renovar. Es el panel del super admin. %>
                <div style="display:flex; align-items:center; gap:6px; margin:0 0 12px; padding-left:126px;">
                  <span style="color:#6b7280; font-size:12px;">Token:</span>
                  <% if conn[:action_token].present? %>
                    <% tid = "tok-#{inst[:account_id]}-#{conn[:id]}" %>
                    <%# Oculto por defecto; el ojo alterna mostrar/ocultar. `user-select:all`
                        selecciona todo al hacer clic para copiar fácil cuando está visible. %>
                    <code id="<%= tid %>" data-token="<%= conn[:action_token] %>"
                          style="font-size:12px; background:#f3f4f6; padding:3px 6px; border-radius:4px; user-select:all; max-width:260px; overflow:auto; white-space:nowrap;">••••••••••••••••</code>
                    <button type="button" title="Mostrar / ocultar" aria-label="Mostrar u ocultar token"
                            onclick="(function(b){var c=document.getElementById('<%= tid %>');var shown=c.dataset.shown==='1';c.textContent=shown?'••••••••••••••••':c.dataset.token;c.dataset.shown=shown?'0':'1';b.textContent=shown?'👁':'🙈';})(this)"
                            style="border:1px solid #d1d5db; background:#fff; border-radius:4px; padding:3px 7px; cursor:pointer; font-size:13px; line-height:1;">👁</button>
                  <% else %>
                    <span style="color:#d97706; font-size:12px;">sin token</span>
                  <% end %>
                  <%= button_to 'Renovar', rotate_action_token_super_admin_hermes_instance_path(inst[:account_id]),
                        method: :post, params: { connection_id: conn[:id] },
                        class: 'button button--secondary', form_class: 'inline-block',
                        style: 'font-size:12px; padding:4px 10px;',
                        data: { confirm: '¿Renovar el token? El anterior dejará de funcionar de inmediato y hay que actualizar el gateway de Hermes.' } %>
                </div>
              <% end %>
            <% end %>
            <%# Alta de un Hermes nuevo para esta cuenta, con los mismos campos del formulario
                "conectar agente IA" del dashboard. La allowlist es obligatoria: sin IPs el
                agente no podria ejecutar nada. %>
            <details style="margin-top:6px;">
              <summary style="cursor:pointer; color:#2563eb; font-size:12px;">+ Conectar un Hermes a esta cuenta</summary>
              <%= form_with url: create_connection_super_admin_hermes_instance_path(inst[:account_id]), method: :post, local: true, html: { style: 'margin:8px 0 0; display:grid; gap:6px; max-width:420px;' } do |f| %>
                <label style="font-size:12px; color:#6b7280;">Nombre visible
                  <%= f.text_field :name, placeholder: 'Mi agente', required: true,
                                   style: 'width:100%; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;' %>
                </label>
                <label style="font-size:12px; color:#6b7280;">Nombre del agente en Hermes
                  <%= f.text_field :hermes_agent_name, placeholder: 'mi-agente', required: true,
                                   style: 'width:100%; font-family:monospace; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;' %>
                </label>
                <label style="font-size:12px; color:#6b7280;">URL del agente
                  <%= f.text_field :base_url, placeholder: 'http://tu-hermes.ejemplo:PUERTO/p/mi-agente/v1', required: true,
                                   style: 'width:100%; font-family:monospace; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;' %>
                  <span style="display:block; color:#9ca3af; font-size:11px;">Mismo host:puerto que los demas agentes. Incluye el prefijo /p/&lt;agente&gt;/v1.</span>
                </label>
                <label style="font-size:12px; color:#6b7280;">Token del agente
                  <%= f.password_field :token, placeholder: 'Bearer token del agente', autocomplete: 'new-password',
                                       style: 'width:100%; font-family:monospace; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;' %>
                </label>
                <label style="font-size:12px; color:#6b7280;">IPs autorizadas de este Hermes
                  <%= f.text_field :allowed_ips, placeholder: '203.0.113.5, 10.147.17.0/24', required: true,
                                   style: 'width:100%; font-family:monospace; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;' %>
                  <span style="display:block; color:#9ca3af; font-size:11px;">Solo desde estas IPs o rangos podra este Hermes ejecutar acciones. Acepta IP suelta o CIDR, incluidas las de ZeroTier.</span>
                </label>
                <%= f.submit 'Conectar Hermes', class: 'button button--secondary', style: 'font-size:12px; padding:5px 12px; justify-self:start;' %>
              <% end %>
            </details>
          </td>
          <td style="padding:8px; white-space:nowrap;">
            <% if inst[:linked] %>
              <%= button_to 'Desactivar', unlink_account_super_admin_hermes_instance_path(inst[:account_id]), method: :post, class: 'button', form_class: 'inline-block' %>
            <% else %>
              <%= button_to 'Activar', link_account_super_admin_hermes_instance_path(inst[:account_id]), method: :post, class: 'button button--secondary', form_class: 'inline-block' %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @instances.empty? %>
        <tr><td colspan="4" style="padding:16px; color:#9ca3af;">No hay cuentas con Chat IA todavía.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>
