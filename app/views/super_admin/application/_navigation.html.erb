<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
  }
%>

<div class="border-r border-[#8FC4C2] w-16 sm:w-56 flex-shrink-0 h-full flex flex-col bg-gradient-to-b from-[#DAEBDB] to-[#A8D5D3] transition-[width]" role="navigation">

  <!-- Logo fijo arriba -->
  <div class="flex-shrink-0 flex items-center justify-center sm:justify-start mx-2 sm:mx-4 mb-2 border-[#8FC4C2]/60 border-b py-5">
    <%= link_to image_tag('/jabvox/public/logo.png', alt: 'Jabvox', class: 'h-8 w-auto'), super_admin_root_url %>
    <div class="flex-col ml-3 hidden sm:flex">
      <div class="text-sm font-semibold text-[#15605A]">Jabvox</div>
      <div class="text-xs text-[#2d5a52] mt-0.5">Super Admin</div>
    </div>
  </div>

  <!-- Menú central scrollable -->
  <div class="flex-1 overflow-y-auto min-h-0">
    <ul class="py-2">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Dashboard' } %>
      <% hidden_resources = %w[
        account_users access_tokens installation_configs dashboard devise/sessions
        app_configs instance_statuses settings push_diagnostics jabvox_ip_whitelists
        jabvox_saldo_configs jabvox_user_extensions
        jabvox_ticket_helpdesk_configs account_automations
        jabvox_softphone_configs jabvox_softphone_extensions
        jabvox_plans jabvox_payment_gateway_configs jabvox_provisioning_transactions
        jabvox_billing_configs hermes_instances
      ] %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if hidden_resources.include? resource.resource %>
        <% next if resource.resource == "platform_banners" && !JabvoxApp.jabvox_cloud? %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym] || 'icon-folder-3-line',
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>
      <% end %>

      <!-- Módulos Jabvox -->
      <li class="hidden sm:block px-5 pt-3 pb-1 text-[10px] font-semibold uppercase tracking-wide text-[#2d5a52]/60">Módulos</li>
      <%= render partial: "nav_item", locals: { icon: 'icon-voice-line', url: super_admin_jabvox_saldo_configs_url, label: 'Saldo VoIP' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-chat-smile-3-line', url: super_admin_jabvox_ticket_helpdesk_configs_url, label: 'Tickets Helpdesk' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-robot-line', url: super_admin_hermes_instances_url, label: 'Hermes' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-chat-smile-3-line', url: super_admin_support_widget_url, label: 'Widget de Soporte' } %>

      <!-- Telefonía / Softphone -->
      <li class="hidden sm:block px-5 pt-3 pb-1 text-[10px] font-semibold uppercase tracking-wide text-[#2d5a52]/60">Telefonía</li>
      <%= render partial: "nav_item", locals: { icon: 'icon-voice-line', url: super_admin_jabvox_softphone_configs_url, label: 'Softphone' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-book-2-line', url: super_admin_jabvox_softphone_extensions_url, label: 'Extensiones' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: status_super_admin_jabvox_softphone_extensions_url, label: 'Estado en vivo' } %>

      <!-- Pagos -->
      <li class="hidden sm:block px-5 pt-3 pb-1 text-[10px] font-semibold uppercase tracking-wide text-[#2d5a52]/60">Pagos</li>
      <%= render partial: "nav_item", locals: { icon: 'icon-folder-3-line', url: super_admin_jabvox_plans_url, label: 'Planes' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-gear', url: super_admin_jabvox_payment_gateway_configs_url, label: 'Pasarelas' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-refresh-line', url: super_admin_jabvox_provisioning_transactions_url, label: 'Transacciones' } %>

      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>

  <!-- Links utilitarios fijos abajo -->
  <div class="flex-shrink-0 border-t border-[#8FC4C2]/60">
    <ul class="py-2">
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Sidekiq Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Instance Health' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: 'Push Diagnostics' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Agent Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Logout' } %>
    </ul>
  </div>

</div>
