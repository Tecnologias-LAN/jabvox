<% content_for(:title) { 'Saldo IA' } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Saldo IA — Proveedor</h1>
</header>

<section class="main-content__body">
  <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
  <% if alert %><p class="flash flash--error"><%= alert %></p><% end %>

  <!-- Pestañas -->
  <% tabs = { 'connection' => 'Conexión (master)', 'accounts' => 'Por cuenta', 'balances' => 'Saldos' } %>
  <div style="display:flex; gap:4px; border-bottom:1px solid #e5e7eb; margin-bottom:20px;">
    <% tabs.each do |key, label| %>
      <%= link_to label, super_admin_ai_provider_config_path(tab: key),
            style: "padding:8px 16px; font-size:13px; text-decoration:none; border-bottom:2px solid #{@tab == key ? '#15605A' : 'transparent'}; color:#{@tab == key ? '#15605A' : '#6b7280'}; font-weight:#{@tab == key ? '600' : '400'};" %>
    <% end %>
  </div>

  <!-- ================= TAB: Conexión (master) ================= -->
  <% if @tab == 'connection' %>
    <div style="margin-bottom:24px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
      <p style="font-size:13px; color:#374151; margin:0;">
        Conecta el <strong>proveedor de IA</strong> con su <strong>master key</strong> (se guarda
        cifrada, nunca se muestra). Cada cuenta tendrá su team con saldo: el del plan se
        restablece cada mes y lo comprado aparte se acumula.
      </p>
    </div>

    <h2 style="font-size:15px; font-weight:600; margin:0 0 12px;">Estado</h2>
    <div style="margin-bottom:20px; font-size:13px; color:#374151;">
      Conexión:
      <strong style="color:<%= { 'connected' => '#16a34a', 'error' => '#b91c1c' }[@summary[:status]] || '#b45309' %>;">
        <%= { 'connected' => 'Conectado', 'error' => 'Error', 'disconnected' => 'Sin verificar' }[@summary[:status]] %>
      </strong>
      · Habilitado: <strong><%= @summary[:enabled] ? 'Sí' : 'No' %></strong>
      · Master key: <strong><%= @summary[:master_key_set] ? 'Configurada' : 'No configurada' %></strong>
      <% if @summary[:last_error].present? %><br><span style="color:#b91c1c;">Último error: <%= @summary[:last_error] %></span><% end %>
      <% if @summary[:last_check_at].present? %><br><span style="color:#6b7280;">Última verificación: <%= @summary[:last_check_at] %></span><% end %>
    </div>

    <%= form_with url: super_admin_ai_provider_config_path, method: :patch, local: true do |form| %>
      <div class="flex mb-4">
        <div class="field-unit__label"><%= form.label :provider_name, 'Nombre del proveedor' %></div>
        <div class="-mt-2 field-unit__field">
          <%= form.text_field :provider_name, value: @summary[:provider_name], placeholder: 'Ej: Proveedor IA' %>
        </div>
      </div>
      <div class="flex mb-4">
        <div class="field-unit__label"><%= form.label :base_url, 'URL base' %></div>
        <div class="-mt-2 field-unit__field">
          <%= form.text_field :base_url, value: @summary[:base_url], placeholder: 'https://proxy.ejemplo.com' %>
          <p class="pt-2 text-xs italic text-slate-400">Debe usar https:// (salvo hosts locales). La master key viaja como Bearer.</p>
        </div>
      </div>
      <div class="flex mb-4">
        <div class="field-unit__label"><%= form.label :master_key, 'Master key' %></div>
        <div class="-mt-2 field-unit__field">
          <%= form.password_field :master_key, value: '', autocomplete: 'new-password',
                placeholder: @summary[:master_key_set] ? '•••••••• (configurada — vacío para conservar)' : 'sk-...' %>
          <p class="pt-2 text-xs italic text-slate-400">Se guarda cifrada. Vacía para conservar la actual. Nunca sale al navegador.</p>
        </div>
      </div>
      <div class="flex mb-4">
        <div class="field-unit__label"><%= form.label :enabled, 'Habilitado' %></div>
        <div class="-mt-2 field-unit__field">
          <%= form.check_box :enabled, checked: @summary[:enabled] %>
          <span class="text-xs italic text-slate-400">Si está deshabilitado, no se sincroniza saldo ni corre el worker mensual.</span>
        </div>
      </div>
      <div class="flex mb-4">
        <div class="field-unit__label"></div>
        <div class="-mt-2 field-unit__field"><%= form.submit 'Guardar', class: 'button' %></div>
      </div>
    <% end %>

    <h2 style="font-size:15px; font-weight:600; margin:20px 0 8px;">Probar conexión</h2>
    <%= form_with url: test_connection_super_admin_ai_provider_config_path, method: :post, local: true do |form| %>
      <%= form.submit 'Probar conexión', class: 'button' %>
      <p class="pt-2 text-xs italic text-slate-400">Consulta los modelos del proveedor para verificar URL + master key.</p>
    <% end %>
  <% end %>

  <!-- ================= TAB: Por cuenta ================= -->
  <% if @tab == 'accounts' %>
    <div style="margin-bottom:20px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
      <p style="font-size:13px; color:#374151; margin:0;">
        <strong>Aprovisionar</strong> crea el team de la cuenta en el proveedor y le aplica el
        saldo del plan. <strong>Recargar</strong> suma saldo comprado (se acumula).
      </p>
      <% unless @summary[:enabled] %>
        <p style="font-size:13px; color:#b91c1c; margin:8px 0 0;">⚠️ El proveedor está deshabilitado. Actívalo en la pestaña <em>Conexión</em>.</p>
      <% end %>
    </div>

    <!-- Sincronizar TODO desde el proveedor -->
    <div style="margin-bottom:24px; padding:16px; border:1px solid #e5e7eb; border-radius:8px; background:#f0fdf4;">
      <h2 style="font-size:15px; font-weight:600; margin:0 0 4px;">Sincronizar desde el proveedor</h2>
      <p style="font-size:12px; color:#6b7280; margin:0 0 12px;">
        Trae <strong>todos</strong> los teams que existen en el proveedor y los refleja aquí.
        Los que traen <code>crm_id</code> en su metadata o se llaman <code>crm-&lt;id&gt;</code>
        se ligan automáticamente a su cuenta; el resto queda abajo como <em>sin cuenta</em>
        para que los ligues a mano. No borra nada ni pisa los saldos locales.
      </p>
      <%= button_to 'Sincronizar ahora', sync_provider_super_admin_ai_provider_config_path,
            method: :post, class: 'button',
            data: { confirm: '¿Traer todos los teams del proveedor e importarlos a Jabvox?' } %>
    </div>

    <!-- Crear team manualmente para CUALQUIER cuenta (sin depender del plan) -->
    <div style="margin-bottom:24px; padding:16px; border:1px solid #e5e7eb; border-radius:8px;">
      <h2 style="font-size:15px; font-weight:600; margin:0 0 4px;">Crear team y ligar a una cuenta</h2>
      <p style="font-size:12px; color:#6b7280; margin:0 0 12px;">
        Crea el team en el proveedor y lo liga a la cuenta que elijas, sin depender del
        plan. El saldo inicial (opcional) se suma como saldo comprado (no se restablece).
      </p>
      <%= form_with url: manual_setup_super_admin_ai_provider_config_path, method: :post, local: true do |f| %>
        <div style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
          <div>
            <label style="display:block; font-size:12px; color:#374151; margin-bottom:4px;">Cuenta</label>
            <%= f.select :account_id,
                  options_for_select(@account_options),
                  { include_blank: 'Selecciona una cuenta…' },
                  { required: true, style: 'min-width:280px;', data: { jabvox_account_select: true } } %>
          </div>
          <div>
            <label style="display:block; font-size:12px; color:#374151; margin-bottom:4px;">Saldo inicial (USD, opcional)</label>
            <%= f.number_field :initial_usd, step: '0.01', min: '0', placeholder: '0.00', style: 'width:140px;' %>
          </div>
          <%= f.submit 'Crear team y ligar', class: 'button' %>
        </div>
      <% end %>
    </div>

    <!-- Teams del proveedor sin cuenta asignada -->
    <% if Array(@orphans).any? %>
      <div style="margin-bottom:24px; padding:16px; border:1px solid #fcd34d; border-radius:8px; background:#fffbeb;">
        <h2 style="font-size:15px; font-weight:600; margin:0 0 4px;">
          Teams en el proveedor sin cuenta (<%= @orphans.size %>)
        </h2>
        <p style="font-size:12px; color:#6b7280; margin:0 0 12px;">
          Existen en el proveedor pero no se pudieron mapear a ninguna cuenta. Elige la cuenta
          a la que pertenece cada uno.
        </p>
        <table class="w-full" style="font-size:13px;">
          <thead>
            <tr style="text-align:left; border-bottom:1px solid #fcd34d;">
              <th style="padding:6px;">Team</th>
              <th style="padding:6px; text-align:right;">Tope</th>
              <th style="padding:6px; text-align:right;">Gastado</th>
              <th style="padding:6px;">Ligar a cuenta</th>
            </tr>
          </thead>
          <tbody>
            <% @orphans.each do |orphan| %>
              <tr style="border-bottom:1px solid #fef3c7;">
                <td style="padding:6px;">
                  <strong><%= orphan.team_alias_jabvox.presence || '(sin alias)' %></strong><br>
                  <span style="color:#6b7280; font-family:monospace; font-size:11px;"><%= orphan.team_id_jabvox %></span>
                </td>
                <td style="padding:6px; text-align:right;">
                  <%= orphan.remote_max_budget_jabvox ? "$#{format('%.2f', orphan.remote_max_budget_jabvox)}" : 'Sin tope' %>
                </td>
                <td style="padding:6px; text-align:right;">$<%= format('%.4f', (orphan.cached_spend_jabvox || 0).to_f) %></td>
                <td style="padding:6px;">
                  <%= form_with url: link_account_super_admin_ai_provider_config_path, method: :post, local: true do |f| %>
                    <%= f.hidden_field :provider_account_id, value: orphan.id %>
                    <div style="display:flex; gap:6px; align-items:center;">
                      <%= f.select :account_id, options_for_select(@account_options),
                            { include_blank: 'Selecciona…' },
                            { required: true, style: 'min-width:240px;', data: { jabvox_account_select: true } } %>
                      <%= f.submit 'Ligar', class: 'button' %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%# Virtual keys de UNA cuenta con su consumo (llega por ?show_keys=<account_id> desde el
        boton "Virtual keys" de la tabla). El proveedor NUNCA devuelve la key en claro: solo
        su alias, su hash (token_id), el gasto acumulado y el tope. %>
    <% if @keys_account_id.present? %>
      <div style="margin-bottom:24px; padding:16px; border:1px solid #c7d2fe; background:#eef2ff; border-radius:8px;">
        <h2 style="font-size:15px; font-weight:600; margin:0 0 4px;">
          Virtual keys de la cuenta #<%= @keys_account_id %>
        </h2>
        <% if @keys_error.present? %>
          <p style="color:#b91c1c; margin:8px 0 0; font-size:13px;">Error: <%= @keys_error %></p>
        <% elsif Array(@account_keys).empty? %>
          <p style="color:#b45309; margin:8px 0 0; font-size:13px;">
            Esta cuenta no tiene ninguna virtual key todavia.
          </p>
        <% else %>
          <table style="width:100%; border-collapse:collapse; font-size:13px; margin-top:10px; background:#fff;">
            <thead>
              <tr style="border-bottom:1px solid #e5e7eb; text-align:left;">
                <th style="padding:8px;">Alias</th>
                <th style="padding:8px;">Key (hash)</th>
                <th style="padding:8px; text-align:right;">Consumo</th>
                <th style="padding:8px; text-align:right;">Tope</th>
                <th style="padding:8px;">Modelos</th>
                <th style="padding:8px;">Estado</th>
              </tr>
            </thead>
            <tbody>
              <% @account_keys.each do |k| %>
                <tr style="border-bottom:1px solid #f3f4f6;">
                  <td style="padding:8px;"><%= k['key_alias'].presence || '—' %></td>
                  <td style="padding:8px; font-family:monospace; font-size:11px; color:#6b7280;">
                    <%= k['token'].to_s.first(20) %><%= '…' if k['token'].to_s.length > 20 %>
                  </td>
                  <td style="padding:8px; text-align:right;">
                    <strong>$<%= format('%.4f', k['spend'].to_f) %></strong>
                  </td>
                  <td style="padding:8px; text-align:right;">
                    <%= k['max_budget'].present? ? "$#{format('%.2f', k['max_budget'].to_f)}" : 'sin tope' %>
                  </td>
                  <td style="padding:8px; font-size:11px; color:#6b7280;">
                    <%= Array(k['models']).presence&.join(', ') || 'todos' %>
                  </td>
                  <td style="padding:8px;">
                    <% if k['blocked'] %>
                      <span style="color:#b91c1c;">bloqueada</span>
                    <% else %>
                      <span style="color:#16a34a;">activa</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <p style="font-size:11px; color:#6b7280; margin:8px 0 0;">
            El consumo lo reporta el proveedor. La key en claro solo se muestra al crearla:
            despues no se puede recuperar, solo rotar.
          </p>
        <% end %>
      </div>
    <% end %>

    <!-- Diagnóstico: qué keys ve Jabvox realmente en un team del proveedor -->
    <div style="margin-bottom:24px; padding:16px; border:1px solid #e5e7eb; border-radius:8px;">
      <h2 style="font-size:15px; font-weight:600; margin:0 0 4px;">Inspeccionar un team</h2>
      <p style="font-size:12px; color:#6b7280; margin:0 0 12px;">
        Lista las virtual keys que el proveedor devuelve para un team, con el team al que
        pertenece cada una. Útil cuando una key creada directamente en el proveedor no
        aparece en la pantalla de la cuenta.
      </p>
      <%= form_with url: super_admin_ai_provider_config_path, method: :get, local: true do |f| %>
        <%= hidden_field_tag :tab, 'accounts' %>
        <div style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
          <div>
            <label style="display:block; font-size:12px; color:#374151; margin-bottom:4px;">ID del team</label>
            <%= text_field_tag :inspect_team, params[:inspect_team], placeholder: 'team_...', style: 'min-width:320px; font-family:monospace;' %>
          </div>
          <%= submit_tag 'Inspeccionar', class: 'button', name: nil %>
        </div>
      <% end %>

      <% if @inspection.present? %>
        <div style="margin-top:14px; font-size:13px;">
          <% if @inspection[:error].present? %>
            <p style="color:#b91c1c; margin:0;">Error: <%= @inspection[:error] %></p>
          <% else %>
            <p style="color:#374151; margin:0 0 8px;">
              El proveedor reporta <strong><%= @inspection[:total_count] %></strong> key(s)
              en <strong><%= @inspection[:total_pages] %></strong> página(s).
              Modelos del team:
              <strong><%= @inspection[:team_models].presence&.join(', ') || 'todos (sin restricción)' %></strong>
            </p>
            <% if @inspection[:keys].empty? %>
              <p style="color:#b45309; margin:0;">El proveedor no devolvió ninguna key para ese team.</p>
            <% else %>
              <table class="w-full" style="font-size:12px;">
                <thead>
                  <tr style="text-align:left; border-bottom:1px solid #e5e7eb;">
                    <th style="padding:6px;">Nombre</th>
                    <th style="padding:6px;">Team de la key</th>
                    <th style="padding:6px;">Modelos</th>
                    <th style="padding:6px; text-align:right;">Gastado</th>
                    <th style="padding:6px;">Hash</th>
                  </tr>
                </thead>
                <tbody>
                  <% @inspection[:keys].each do |k| %>
                    <tr style="border-bottom:1px solid #f3f4f6;">
                      <td style="padding:6px;"><%= k[:alias].presence || '(sin nombre)' %></td>
                      <td style="padding:6px; font-family:monospace;">
                        <% if k[:team_id].to_s == @inspection[:team_id] %>
                          <span style="color:#16a34a;">✓ coincide</span>
                        <% else %>
                          <span style="color:#b45309;"><%= k[:team_id].presence || '(sin team)' %></span>
                        <% end %>
                      </td>
                      <td style="padding:6px;"><%= k[:models].presence&.join(', ') || 'hereda del team' %></td>
                      <td style="padding:6px; text-align:right;">$<%= format('%.4f', k[:spend].to_f) %></td>
                      <td style="padding:6px; font-family:monospace; color:#6b7280;"><%= k[:token] %>…</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <h2 style="font-size:15px; font-weight:600; margin:0 0 8px;">Cuentas con plan de IA</h2>
    <%= render 'super_admin/ai_provider_config/accounts_table', mode: :manage %>
  <% end %>

  <!-- "todos" por proveedor: marca o desmarca de golpe los modelos de ese proveedor,
       sin dejar de poder elegirlos uno a uno. -->
  <% if @tab == 'accounts' %>
    <script>
      (function () {
        document.querySelectorAll('[data-jabvox-toggle-provider]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var group = btn.closest('[data-jabvox-provider-group]');
            if (!group) return;
            var boxes = group.querySelectorAll('input[type="checkbox"]');
            // Si ya están todos marcados, el botón los desmarca.
            var allChecked = Array.prototype.every.call(boxes, function (b) { return b.checked; });
            Array.prototype.forEach.call(boxes, function (b) { b.checked = !allChecked; });
          });
        });
      })();
    </script>
  <% end %>

  <!-- Buscador de cuentas: convierte cada <select> de cuentas en un combo filtrable.
       Sin dependencias: se apoya en un <datalist> espejo y valida contra las opciones
       reales, de modo que solo se pueda enviar un id de cuenta existente. -->
  <% if @tab == 'accounts' %>
    <script>
      (function () {
        document.querySelectorAll('select[data-jabvox-account-select]').forEach(function (select) {
          var options = Array.prototype.slice.call(select.options).filter(function (o) { return o.value; });
          if (options.length < 8) return; // con pocas cuentas el <select> nativo basta

          var box = document.createElement('input');
          box.type = 'search';
          box.placeholder = 'Filtrar por nombre o #id…';
          box.setAttribute('aria-label', 'Filtrar cuentas');
          box.style.cssText = 'display:block; margin-bottom:4px; width:100%; box-sizing:border-box;';
          select.parentNode.insertBefore(box, select);

          box.addEventListener('input', function () {
            var q = box.value.trim().toLowerCase();
            var firstVisible = null;
            options.forEach(function (option) {
              var hit = !q || option.text.toLowerCase().indexOf(q) !== -1;
              option.hidden = !hit;
              if (hit && !firstVisible) firstVisible = option;
            });
            // Si la selección actual quedó oculta, salta a la primera coincidencia.
            if (select.selectedOptions[0] && select.selectedOptions[0].hidden) {
              select.value = firstVisible ? firstVisible.value : '';
            }
          });
        });
      })();
    </script>
  <% end %>

  <!-- ================= TAB: Saldos ================= -->
  <% if @tab == 'balances' %>
    <div style="margin-bottom:20px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
      <p style="font-size:13px; color:#374151; margin:0;">Saldo de cada cuenta: del plan (se restablece cada mes) + comprado (se acumula) − gastado.</p>
    </div>
    <%= render 'super_admin/ai_provider_config/accounts_table', mode: :view %>
  <% end %>
</section>
