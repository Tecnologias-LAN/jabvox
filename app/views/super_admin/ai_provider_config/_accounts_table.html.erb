<%# Tabla de cuentas con saldo de IA. mode: :manage (con acciones) o :view (solo lectura). %>
<table class="w-full" style="font-size:13px;">
  <thead>
    <tr style="text-align:left; border-bottom:1px solid #e5e7eb;">
      <th style="padding:8px;">Cuenta</th>
      <th style="padding:8px;">Plan</th>
      <th style="padding:8px;">Estado</th>
      <th style="padding:8px; text-align:right;">Plan</th>
      <th style="padding:8px; text-align:right;">Comprado</th>
      <th style="padding:8px; text-align:right;">Total</th>
      <th style="padding:8px; text-align:right;">Gastado</th>
      <th style="padding:8px; text-align:right;">Restante</th>
      <% if mode == :manage %>
        <th style="padding:8px;">Acciones</th>
        <th style="padding:8px;">Modelos</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% Array(@rows).each do |row| %>
      <% pa = row[:provider_account] %>
      <tr style="border-bottom:1px solid #f3f4f6;">
        <td style="padding:8px;"><strong><%= row[:account].name %></strong><br><span style="color:#6b7280;">#<%= row[:account].id %></span></td>
        <td style="padding:8px;"><%= row[:plan]&.name %><br><span style="color:#6b7280;">$<%= format('%.2f', (row[:plan]&.ai_budget_cents_jabvox.to_i / 100.0)) %>/mes</span></td>
        <td style="padding:8px;">
          <% if row[:connected] %>
            <span style="color:#16a34a;">● Conectada</span><br>
            <span style="color:#6b7280; font-family:monospace; font-size:11px;"><%= pa.team_alias_jabvox.presence || pa.team_id_jabvox %></span>
            <% if pa.imported? %><br><span style="color:#6b7280; font-size:11px;">importada del proveedor</span><% end %>
            <% if pa.budget_diverged? %>
              <br><span style="color:#b45309; font-size:11px;" title="El tope en el proveedor no coincide con el saldo calculado aquí.">
                ⚠ tope remoto $<%= format('%.2f', pa.remote_max_budget_jabvox) %>
              </span>
            <% end %>
            <% if pa.remote_blocked_jabvox %><br><span style="color:#b91c1c; font-size:11px;">bloqueada en el proveedor</span><% end %>
          <% else %><span style="color:#b45309;">○ Sin conectar</span><% end %>
        </td>
        <td style="padding:8px; text-align:right;"><%= pa ? "$#{format('%.2f', pa.plan_budget_cents_jabvox / 100.0)}" : '—' %></td>
        <td style="padding:8px; text-align:right;"><%= pa ? "$#{format('%.2f', pa.purchased_budget_cents_jabvox / 100.0)}" : '—' %></td>
        <td style="padding:8px; text-align:right;"><strong><%= pa ? "$#{format('%.2f', pa.total_budget_usd)}" : '—' %></strong></td>
        <td style="padding:8px; text-align:right;"><%= pa ? "$#{format('%.4f', (pa.cached_spend_jabvox || 0).to_f)}" : '—' %></td>
        <td style="padding:8px; text-align:right;"><%= pa ? "$#{format('%.2f', pa.remaining_usd)}" : '—' %></td>
        <% if mode == :manage %>
          <td style="padding:8px; white-space:nowrap;">
            <% unless row[:connected] %>
              <%= button_to 'Aprovisionar', provision_super_admin_ai_provider_config_path(account_id: row[:account].id),
                    method: :post, class: 'button', form_class: 'inline-block',
                    data: { confirm: "¿Crear team y aplicar el saldo del plan a la cuenta #{row[:account].id}?" } %>
            <% end %>
            <%= form_with url: recharge_super_admin_ai_provider_config_path, method: :post, local: true, class: 'inline-block', style: 'margin-left:6px;' do |f| %>
              <%= f.hidden_field :account_id, value: row[:account].id %>
              <%= f.number_field :amount_usd, step: '0.01', min: '0', placeholder: 'USD', style: 'width:70px;' %>
              <%= f.submit 'Recargar', class: 'button' %>
            <% end %>
            <% if row[:connected] %>
              <%= button_to 'Desligar', unlink_account_super_admin_ai_provider_config_path(provider_account_id: pa.id),
                    method: :post, class: 'button', form_class: 'inline-block',
                    data: { confirm: "¿Desligar el team de la cuenta #{row[:account].id}? El team seguirá existiendo en el proveedor." } %>
              <%= link_to 'Inspeccionar',
                    super_admin_ai_provider_config_path(tab: 'accounts', inspect_team: pa.team_id_jabvox),
                    class: 'button', style: 'margin-left:6px;' %>
            <% end %>
          </td>
          <!-- Modelos del team: vacío = todos los del proveedor -->
          <td style="padding:8px; min-width:260px;">
            <% if row[:connected] %>
              <% if Array(@available_models).any? %>
                <% selected = Array(pa.remote_models_jabvox) %>
                <%= form_with url: set_team_models_super_admin_ai_provider_config_path, method: :post, local: true do |f| %>
                  <%= f.hidden_field :provider_account_id, value: pa.id %>
                  <%# Casillas agrupadas por proveedor: se elige modelo a modelo ('gpt-4'),
                      no el proveedor entero. El botón de cada grupo marca/desmarca todos. %>
                  <div style="max-height:180px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:6px; padding:8px;">
                    <% @models_by_provider.each do |provider, names| %>
                      <div style="margin-bottom:8px;" data-jabvox-provider-group>
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
                          <strong style="font-size:11px; text-transform:uppercase; color:#374151; letter-spacing:.03em;">
                            <%= provider %>
                          </strong>
                          <button type="button" data-jabvox-toggle-provider
                                  style="font-size:10px; color:#15605A; background:none; border:none; cursor:pointer; padding:0; text-decoration:underline;">
                            todos
                          </button>
                        </div>
                        <% names.each do |model| %>
                          <label style="display:block; font-size:12px; color:#374151; padding:1px 0 1px 8px; cursor:pointer;">
                            <%= check_box_tag 'models[]', model, selected.include?(model),
                                  id: "m-#{pa.id}-#{model.parameterize}", style: 'margin-right:5px;' %>
                            <%= model %>
                          </label>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <div style="margin-top:6px;">
                    <%= f.submit 'Guardar modelos', class: 'button' %>
                  </div>
                  <p style="font-size:11px; color:#6b7280; margin:4px 0 0;">
                    <% if selected.empty? %>
                      Acceso a <strong>todos</strong> los modelos.
                    <% else %>
                      <%= selected.size %> modelo(s) seleccionado(s). Ninguno = todos.
                    <% end %>
                  </p>
                <% end %>
              <% else %>
                <span style="font-size:12px; color:#6b7280;">
                  <% if Array(pa.remote_models_jabvox).any? %>
                    <%= pluralize(pa.remote_models_jabvox.size, 'modelo') %> asignado(s)
                  <% else %>
                    Todos
                  <% end %>
                  <br><em>(conecta el proveedor para editarlos)</em>
                </span>
              <% end %>
            <% else %>
              <span style="color:#6b7280;">—</span>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
    <% if Array(@rows).empty? %>
      <tr><td colspan="<%= mode == :manage ? 10 : 8 %>" style="padding:16px; color:#6b7280;">No hay cuentas con planes que incluyan saldo de IA. Pon "Ai budget in usd" en un plan.</td></tr>
    <% end %>
  </tbody>
</table>
