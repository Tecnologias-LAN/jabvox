<% content_for(:title) { 'ContextForge / Hermes' } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">ContextForge / Hermes</h1>
</header>

<section class="main-content__body">
  <% if notice %><p class="flash flash--notice"><%= notice %></p><% end %>
  <% if alert %><p class="flash flash--error"><%= alert %></p><% end %>

  <div style="margin-bottom:24px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
    <p style="font-size:13px; color:#374151; margin:0;">
      Configuración <strong>global</strong> del gateway <strong>ContextForge (IBM MCP Gateway)</strong>
      y del gateway de <strong>Hermes</strong>. Con estos valores el super admin aprovisiona cada
      cuenta por separado (team → MCPs → virtual server → scoped token) desde su ficha.
      ContextForge, el servidor MCP y Hermes corren <strong>fuera</strong> de Jabvox.
    </p>
  </div>

  <%= form_with url: super_admin_context_forge_config_path, method: :post do |form| %>
    <div class="flex mb-8">
      <div class="field-unit__label">
        <%= form.label 'app_config[CONTEXTFORGE_SERVICE_URL]', 'ContextForge Service URL' %>
      </div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field 'app_config[CONTEXTFORGE_SERVICE_URL]', value: @app_config['CONTEXTFORGE_SERVICE_URL'] %>
        <p class="pt-2 text-xs italic text-slate-400">
          Base URL de la API admin de ContextForge (la llama este Jabvox). Ej.
          <code>http://127.0.0.1:4444</code> si corre en Docker en esta máquina.
        </p>
      </div>
    </div>

    <div class="flex mb-8">
      <div class="field-unit__label">
        <%= form.label 'app_config[CONTEXTFORGE_ADMIN_KEY]', 'Admin Key (maestra)' %>
      </div>
      <div class="-mt-2 field-unit__field">
        <%= form.password_field 'app_config[CONTEXTFORGE_ADMIN_KEY]', value: '',
              placeholder: @app_config['CONTEXTFORGE_ADMIN_KEY'].present? ? 'configurada — deja en blanco para conservar' : '' %>
        <p class="pt-2 text-xs italic text-slate-400">
          Token admin de ContextForge para crear teams/servers/tokens. Nunca se re-muestra.
        </p>
      </div>
    </div>

    <div class="flex mb-8">
      <div class="field-unit__label">
        <%= form.label 'app_config[CONTEXTFORGE_HERMES_URL]', 'Hermes Gateway URL' %>
      </div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field 'app_config[CONTEXTFORGE_HERMES_URL]', value: @app_config['CONTEXTFORGE_HERMES_URL'] %>
        <p class="pt-2 text-xs italic text-slate-400">
          URL del gateway de Hermes (endpoint OpenAI-compatible que usa el Consumer del Chat IA).
        </p>
      </div>
    </div>

    <div class="flex mb-8">
      <div class="field-unit__label">
        <%= form.label 'app_config[CONTEXTFORGE_JABVOX_CALLBACK_URL]', 'Jabvox Callback URL' %>
      </div>
      <div class="-mt-2 field-unit__field">
        <%= form.text_field 'app_config[CONTEXTFORGE_JABVOX_CALLBACK_URL]', value: @app_config['CONTEXTFORGE_JABVOX_CALLBACK_URL'] %>
        <p class="pt-2 text-xs italic text-slate-400">
          URL por la que los MCP vuelven a alcanzar este Jabvox para leer datos de la cuenta.
        </p>
      </div>
    </div>

    <div style="display:flex; gap:8px; align-items:center;">
      <%= form.submit 'Guardar', class: 'button' %>
      <%= link_to 'Probar conexión', health_super_admin_context_forge_config_path, class: 'button' %>
    </div>
  <% end %>

  <% if defined?(@health) && @health %>
    <div style="margin-top:24px; padding:16px; border-radius:8px; <%= @health.success? ? 'background:#dcfce7; border:1px solid #86efac;' : 'background:#fee2e2; border:1px solid #fca5a5;' %>">
      <strong><%= @health.success? ? '✓ Conexión correcta' : '✗ Falló la conexión' %></strong>
      <% unless @health.success? %>
        <p style="font-size:13px; color:#991b1b; margin-top:6px;"><%= @health.error %></p>
      <% end %>
    </div>
  <% end %>
</section>
