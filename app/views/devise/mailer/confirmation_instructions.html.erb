<%
  brand_name = global_config['BRAND_NAME'] || 'Jabvox'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = 'Bienvenido'
  heading = 'Confirma tu correo para empezar'
  intro_text =
    "Bienvenido a #{brand_name}. Solo necesitamos verificar tu dirección de correo antes de que empieces a usar tu cuenta."
  supporting_text = 'Solo toma un momento.'
  action_text = 'Confirmar mi cuenta'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Nuevo correo', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Cambio de correo'
    heading = 'Confirma tu nuevo correo electrónico'
    intro_text = "Recibimos una solicitud para cambiar el correo electrónico de tu cuenta de #{brand_name}."
    supporting_text = 'Confirma el nuevo correo a continuación para finalizar el cambio.'
    action_text = 'Confirmar correo'
  elsif @resource.confirmed?
    eyebrow = 'Cuenta lista'
    heading = 'Tu cuenta está lista'
    intro_text = "Tu cuenta de #{brand_name} ya está activa."
    supporting_text = 'Usa el botón de abajo para iniciar sesión y continuar donde lo dejaste.'
    action_text = 'Abrir mi cuenta'
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = 'Invitación al espacio de trabajo'
    heading = account_name.present? ? "Te invitaron a unirte a #{account_name}" : "Te invitaron a probar #{brand_name}"
    intro_text = if account_name.present?
      "#{inviter.name} te invitó a unirte al espacio de trabajo #{account_name} en #{brand_name}."
    else
      "#{inviter.name} te invitó a probar #{brand_name}."
    end
    supporting_text = 'Crea tu cuenta para empezar a colaborar con tu equipo.'
    action_text = 'Aceptar invitación'
    action_url = frontend_url(
      'auth/password/edit',
      reset_password_token: @resource.send(:set_reset_password_token)
    )
    detail_rows = [['Invitado por', inviter.name]]
    detail_rows << ['Espacio de trabajo', account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
