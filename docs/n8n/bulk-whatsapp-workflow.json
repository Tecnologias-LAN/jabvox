    {
      "parameters": {
        "jsCode": "// Cruza el resultado de la búsqueda con el lead actual del loop.\nconst ctx = $('Loop Leads').item.json;\nconst raw = $json.payload ?? $json;\nconst lista = Array.isArray(raw) ? raw : [];\nconst tel = String(ctx.numero).replace(/\\D/g, '');\nconst tel10 = tel.slice(-10);\n\nlet contacto = null;\nfor (const c of lista) {\n  const cp = String(c.phone_number || '').replace(/\\D/g, '');\n  if (cp && (cp === tel || cp.slice(-10) === tel10)) { contacto = c; break; }\n}\n\nlet existe_en_inbox = false;\nlet source_id = null;\nif (contacto && Array.isArray(contacto.contact_inboxes)) {\n  const ci = contacto.contact_inboxes.find(x => Number(x?.inbox?.id) === Number(ctx.inbox_id));\n  if (ci) { existe_en_inbox = true; source_id = ci.source_id; }\n}\n\nreturn [{ json: {\n  ...ctx,\n  existe: !!contacto,\n  existe_en_inbox,\n  contact_id: contacto ? contacto.id : null,\n  source_id: source_id || ctx.numero,\n}}];"
      },
