      "id": "rok00000-0000-4000-8000-000000000018",
      "name": "Registrar éxito"
    },
    {
      "parameters": {
        "jsCode": "// Marca el envío como fallido (sin romper el loop) para el reporte final.\nconst ctx = $('Loop Leads').item.json;\nconst err = $json.error?.message || $json.message || JSON.stringify($json.error ?? $json).slice(0, 300);\nreturn [{ json: {\n  ok: false,\n  numero: ctx.numero,\n  nombre: ctx.nombre,\n  lead_id: ctx.lead_id ?? null,\n  error: err,\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        80
      ],
      "id": "rko00000-0000-4000-8000-000000000019",
      "name": "Registrar fallo"
    },
    {
      "parameters": {
        "jsCode": "// Junta los resultados de TODAS las iteraciones del loop y arma el reporte.\nconst resultados = [];\nfor (const nodo of ['Registrar éxito', 'Registrar fallo']) {\n  let run = 0;\n  for (;;) {\n    let items;\n    try { items = $(nodo).all(0, run); } catch (e) { break; }\n    for (const it of items) resultados.push(it.json);\n    run += 1;\n  }\n}\n\nconst ctx = $('Preparar contexto').first().json;\nconst enviados = resultados.filter(r => r.ok);\nconst fallidos = resultados.filter(r => !r.ok);\n\nconst detalleFallos = fallidos\n  .map(f => `- ${f.nombre || ''} (${f.numero}): ${f.error}`)\n  .join('\\n');\n\nconst texto = [\n  `Reporte de envío masivo de WhatsApp`,\n  `Cuenta: ${ctx.account_id} | Lote: ${ctx.batch_id ?? '-'} | Bandeja: ${ctx.inbox_name} (${ctx.inbox_id})`,\n  `Bloque ${Number(ctx.chunk_index) + 1} de ${ctx.total_chunks}`,\n  ``,\n  `Total procesados: ${resultados.length}`,\n  `Enviados: ${enviados.length}`,\n  `Fallidos: ${fallidos.length}`,\n  detalleFallos ? `\\nFallos:\\n${detalleFallos}` : '',\n].join('\\n');\n\nreturn [{ json: {\n  response_email: ctx.response_email,\n  asunto: `Envío masivo WhatsApp — cuenta ${ctx.account_id} — ${enviados.length}/${resultados.length} enviados`,\n  texto,\n}}];"
      },
