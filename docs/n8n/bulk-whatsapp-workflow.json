        "jsCode": "// El contacto existía pero no en esta bandeja: toma el source_id nuevo.\nconst ctx = $('Resolver contacto').item.json;\nconst p = $json.payload ?? $json;\n\nreturn [{ json: {\n  ...ctx,\n  source_id: p.source_id || ctx.numero,\n}}];"
