    {
      "parameters": {
        "jsCode": "// Normaliza el payload de Jabvox en UN item de contexto.\n// El payload trae todo lo necesario para servir a CUALQUIER cuenta:\n// base_url, account_id, api_token, inbox_id, mode, response_email y messages[].\nconst body = $json.body ?? $json;\n\nconst ctx = {\n  base_url: String(body.base_url || 'https://app.jabvox.com').replace(/\\/$/, ''),\n  account_id: Number(body.account_id),\n  batch_id: body.batch_id ?? null,\n  inbox_id: Number(body.inbox_id),\n  inbox_name: body.inbox_name || '',\n  mode: body.mode === 'text' ? 'text' : 'template',\n  channel_type: body.channel_type || '',\n  api_token: body.api_token,\n  response_email: body.response_email || '',\n  sent_by_name: body.sent_by_name || '',\n  chunk_index: body.chunk_index ?? 0,\n  total_chunks: body.total_chunks ?? 1,\n};\n\nif (!ctx.api_token || !ctx.account_id || !ctx.inbox_id) {\n  throw new Error('Payload incompleto: se requieren api_token, account_id e inbox_id.');\n}\n\nconst messages = (Array.isArray(body.messages) ? body.messages : [])\n  .filter(m => m && m.numero && m.template)\n  .map(m => ({ ...m, numero: String(m.numero).replace(/\\D/g, '') }));\n\nif (!messages.length) {\n  throw new Error('El payload no trae mensajes válidos.');\n}\n\nreturn [{ json: { ...ctx, messages } }];"
      },
