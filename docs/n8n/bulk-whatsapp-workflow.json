    {
      "parameters": {
        "jsCode": "// Marca el envío como exitoso para el reporte final.\nconst ctx = $('Loop Leads').item.json;\nreturn [{ json: {\n  ok: true,\n  numero: ctx.numero,\n  nombre: ctx.nombre,\n  lead_id: ctx.lead_id ?? null,\n  error: null,\n}}];"
