      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Expande messages[] en un item por destinatario.\n//\n// IMPORTANTE: Jabvox YA resuelve las variables de la plantilla por lead y las\n// manda en m.processed_params = { \"1\": \"valor\", \"2\": \"valor\", ... } segun el\n// mapeo variable->campo elegido en la UI de envio masivo. n8n NO adivina\n// {{1}}=nombre ni lee custom_fields: solo reenvia lo que Jabvox calculo.\nconst ctx = $('Preparar contexto').first().json;\nconst tpls = $json.message_templates || [];\n\nconst items = [];\nfor (const m of ctx.messages) {\n  let contenido = m.template;\n  let template_name = m.template;\n  let template_category = 'UTILITY';\n  let template_language = m.idioma || 'es';\n  const processed_params = (m.processed_params && typeof m.processed_params === 'object')\n    ? m.processed_params\n    : {};\n\n  if (ctx.mode === 'template') {\n    const tpl = tpls.find(t => t.name === m.template);\n    if (tpl) {\n      template_category = tpl.category || template_category;\n      template_language = tpl.language || template_language;\n      const bodyComp = Array.isArray(tpl.components)\n        ? tpl.components.find(c => (c.type || '').toUpperCase() === 'BODY')\n        : null;\n      if (bodyComp && bodyComp.text) {\n        // Texto legible para el reporte: sustituye {{n}} por su valor ya resuelto.\n        // El envio real usa processed_params, no este texto.\n        contenido = bodyComp.text.replace(/\\{\\{\\s*(\\d+)\\s*\\}\\}/g, (_, k) => {\n          const v = processed_params[String(k)];\n          return (v === undefined || v === null) ? '' : String(v);\n        });\n      }\n    }\n  } else {\n    contenido = m.template;\n  }\n\n  const { messages, ...ctxSinMensajes } = ctx;\n  items.push({ json: {\n    ...ctxSinMensajes,\n    ...m,\n    contenido,\n    template_name,\n    template_category,\n    template_language,\n    processed_params,\n  }});\n}\n\nreturn items;"
      },
