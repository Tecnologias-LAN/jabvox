        "jsCode": "// Normaliza la respuesta de creación de contacto y re-adjunta el contexto.\nconst ctx = $('Loop Leads').item.json;\nconst p = $json.payload ?? $json;\nconst contact = p.contact ?? p;\nconst ci = p.contact_inbox ?? null;\n\nreturn [{ json: {\n  ...ctx,\n  contact_id: contact.id,\n  source_id: (ci && ci.source_id) || ctx.numero,\n}}];"
