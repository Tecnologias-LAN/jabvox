      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Elige la conversación existente en NUESTRA bandeja, si hay.\nconst ctx = $('Resolver contacto').item.json;\nconst raw = $json;\nlet lista = [];\nif (Array.isArray(raw)) lista = raw;\nelse if (Array.isArray(raw.payload)) lista = raw.payload;\nelse if (Array.isArray(raw?.data?.payload)) lista = raw.data.payload;\n\nconst conv = lista.find(c => Number(c.inbox_id) === Number(ctx.inbox_id));\n\nreturn [{ json: {\n  ...ctx,\n  conversation_id: conv ? conv.id : null,\n  tiene_conversacion: !!conv,\n}}];"
