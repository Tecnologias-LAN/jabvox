<%
  summary = field.billable_summary.presence || {}
  # Fallback: si no hay billable_summary, mostramos al menos los overrides/keys del JSON.
  json_only = JSON.parse(field.to_s) rescue {}
%>

<div class="w-full">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-semibold text-n-slate-12">Límites y uso</h3>
    <% if summary.present? %>
      <span class="text-xs text-n-slate-11">
        Extra total:
        <strong class="text-n-slate-12 tabular-nums"><%= field.extra_price_cents %></strong>
      </span>
    <% end %>
  </div>

  <% if summary.present? %>
    <div class="overflow-x-auto rounded-lg border border-n-weak">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-n-alpha-2 text-[11px] uppercase tracking-wide text-n-slate-10">
            <th class="text-left font-semibold px-3 py-2">Recurso</th>
            <th class="text-right font-semibold px-3 py-2">Uso</th>
            <th class="text-left font-semibold px-3 py-2 w-40">Nivel</th>
            <th class="text-right font-semibold px-3 py-2">Incluido</th>
            <th class="text-right font-semibold px-3 py-2">Extra</th>
            <th class="text-right font-semibold px-3 py-2">Extra $</th>
          </tr>
        </thead>
        <tbody>
          <% summary.each do |key, data| %>
            <%
              used    = data[:used].to_f
              limit   = data[:limit].to_f
              has_limit = limit.positive?
              pct     = has_limit ? [(used / limit * 100).round, 100].min : 0
              over    = has_limit && used > limit
              # Color de estado: rojo si excede, ámbar si >=80%, verde si ok, gris si sin límite.
              bar = if !has_limit then 'bg-n-slate-6'
                    elsif over then 'bg-red-500'
                    elsif pct >= 80 then 'bg-amber-500'
                    else 'bg-green-500' end
              extra_cnt = data[:extra].to_i
            %>
            <tr class="border-t border-n-weak">
              <td class="px-3 py-2 text-n-slate-12 font-medium capitalize whitespace-nowrap">
                <%= key.to_s.tr('_', ' ') %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">
                <span class="<%= over ? 'text-red-600 font-semibold' : 'text-n-slate-12' %>"><%= data[:used] %></span>
                <span class="text-n-slate-10">/ <%= has_limit ? data[:limit] : '∞' %></span>
              </td>
              <td class="px-3 py-2">
                <% if has_limit %>
                  <div class="h-1.5 w-full rounded-full bg-n-alpha-2 overflow-hidden">
                    <div class="h-full rounded-full <%= bar %>" style="width: <%= pct %>%"></div>
                  </div>
                <% else %>
                  <span class="text-[11px] text-n-slate-9">sin límite</span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-n-slate-11"><%= data[:included] %></td>
              <td class="px-3 py-2 text-right tabular-nums <%= extra_cnt.positive? ? 'text-amber-600 font-medium' : 'text-n-slate-11' %>">
                <%= extra_cnt %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-n-slate-11"><%= data[:extra_price_cents] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <!-- Sin resumen facturable: mostramos los límites configurados de forma compacta. -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% json_only.each do |k, v| %>
        <div class="rounded-md border border-n-weak bg-n-alpha-1 px-3 py-2">
          <div class="text-[11px] uppercase tracking-wide text-n-slate-10 capitalize"><%= k.to_s.tr('_', ' ') %></div>
          <div class="text-sm font-semibold text-n-slate-12 tabular-nums"><%= v.nil? ? '∞' : v %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
