<%#
  TODAS las funciones de la cuenta (Chatwoot + Jabvox), segmentadas por área de negocio
  (Bandejas y Canales, Integraciones, IA y Bots, Automatización, Gestión, Reportes…) con el
  MISMO diseño de secciones agrupadas que los Módulos Jabvox. Los canales (TikTok, WhatsApp,
  Instagram, Facebook, Voz, Web, Email) quedan juntos; las integraciones externas también.
  Las funciones premium se marcan con un candado, sin sacarlas de su categoría temática.
%>
<%
  display_names = SuperAdmin::AccountFeaturesHelper.feature_display_names
  # Filtramos internas/deprecated igual que el panel normal, pero conservamos el on/off real.
  visible = SuperAdmin::AccountFeaturesHelper.filter_internal_features(field.data)
  visible = SuperAdmin::AccountFeaturesHelper.filter_deprecated_features(visible)
  # Sub-features de Jabvox IA (Captain) se gobiernan con "Jabvox IA": no se listan sueltas.
  if SuperAdmin::AccountFeaturesHelper.respond_to?(:filter_jabvox_ia_subfeatures)
    visible = SuperAdmin::AccountFeaturesHelper.filter_jabvox_ia_subfeatures(visible)
  end
  premium = SuperAdmin::AccountFeaturesHelper.account_premium_features
  groups = SuperAdmin::FeatureCategorizationHelper.group(visible, display_names)
%>

<div class="w-full space-y-5">
  <% groups.each do |group| %>
    <section class="rounded-lg border border-n-weak bg-n-alpha-1 overflow-hidden">
      <header class="flex items-center gap-2 px-4 py-2.5 border-b border-n-weak bg-n-alpha-2">
        <span class="text-sm"><%= group[:icon] %></span>
        <h4 class="text-xs font-semibold uppercase tracking-wide text-n-slate-11">
          <%= group[:label] %>
        </h4>
        <span class="ml-auto text-[11px] font-medium text-n-slate-10 tabular-nums">
          <%= group[:on] %>/<%= group[:items].size %>
        </span>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-n-weak">
        <% group[:items].each do |feature_key, display_name, enabled| %>
          <% is_premium = premium.include?(feature_key) %>
          <div class="flex items-center justify-between gap-2 px-4 py-2.5 bg-n-solid-1">
            <span class="flex items-center gap-1.5 min-w-0 text-sm <%= enabled ? 'text-n-slate-12 font-medium' : 'text-n-slate-10' %>">
              <% if is_premium %>
                <span class="shrink-0 inline-flex items-center justify-center h-4 w-4 rounded-full bg-n-amber-3 text-n-amber-11" title="Premium">
                  <svg width="9" height="9"><use xlink:href="#icon-lock-line" /></svg>
                </span>
              <% end %>
              <span class="truncate"><%= display_name %></span>
            </span>
            <% if enabled %>
              <span class="shrink-0 inline-flex items-center justify-center h-5 w-5 rounded-full bg-green-500 text-white">
                <svg width="12" height="12"><use xlink:href="#icon-tick-line" /></svg>
              </span>
            <% else %>
              <span class="shrink-0 inline-flex items-center justify-center h-5 w-5 rounded-full bg-n-alpha-2 text-n-slate-9">
                <svg width="10" height="10" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 10a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
