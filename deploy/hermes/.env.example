# Copia a .env y rellena. NO commitees el .env real.

# ContextForge (IBM MCP Gateway)
CONTEXTFORGE_JWT_SECRET=cambia-este-secreto-largo
CONTEXTFORGE_ADMIN_USER=admin
CONTEXTFORGE_ADMIN_PASSWORD=cambia-este-password

# Cómo el MCP backend vuelve a alcanzar este Jabvox para leer datos de la cuenta.
# En Docker para Mac/Windows: host.docker.internal. En Linux: la IP de docker0 o el dominio público.
CONTEXTFORGE_JABVOX_CALLBACK_URL=http://host.docker.internal:3000

# Hermes (Nous Research) — proveedor de modelo
HERMES_IMAGE=nousresearch/hermes:latest
HERMES_MODEL_PROVIDER=openai
HERMES_MODEL_API_KEY=sk-...
HERMES_MODEL_BASE_URL=
